  InputLines:
    - '// @input SceneObject camera {"hint":"The device Camera / head object. Speed = how fast this moves through the world."}'
    - '// @input Component.Text label {"hint":"Text to write the speed into. If empty, a Text on THIS object is used."}'
    - '// @input string units = "km/h" {"hint":"Units to display: \"m/s\", \"km/h\" or \"mph\"."}'
