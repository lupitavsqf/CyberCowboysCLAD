  InputLines:
    - // @input AssignableType_1 arenaStreamer
    - // @input AssignableType_2 openButton
    - // @input AssignableType_3 closeButton
    - // @input SceneObject panelRoot
    - // @input SceneObject listContainer
    - // @input Asset.ObjectPrefab cardPrefab
    - '// @input Asset.Font uiFont {"hint":"Font for the header + section labels."}'
    - '// @input float cardHeightCm = 8 {"hint":"SIZE DIAL. Height of one card in cm. Everything scales from this."}'
    - '// @input float columns = 2 {"hint":"Cards per row."}'
    - '// @input float panelWidthCm = 30 {"hint":"Total width across all columns, in cm."}'
    - '// @input float colGapCm = 1.5 {"hint":"Gap between columns, in cm."}'
    - '// @input float rowGapCm = 1.5 {"hint":"Gap between rows, in cm."}'
    - '// @input float topStartCm = 11 {"hint":"Where the first section starts, in cm ABOVE the panel centre."}'
    - '// @input float headerTopCm = 15 {"hint":"Header height above the panel centre, in cm."}'
    - '// @input float headerXCm {"hint":"Move the header (CHOOSE LESSON) left/right, in cm from the panel centre. Negative = left, e.g. to line it up with the NOVICE labels."}'
    - '// @input SceneObject headerObject {"hint":"OPTIONAL: if your header is an IMAGE object (e.g. the metallic CHOOSE LESSON), drag it here so Header X/Top Cm move it too."}'
    - '// @input float scrollBtnXCm = 12 {"hint":"Scroll buttons: X of the UP button, in cm from the panel centre (put it to the right of the header)."}'
    - '// @input float scrollBtnYCm = 15 {"hint":"Scroll buttons: Y in cm above the panel centre (match Header Top Cm to line up with the header)."}'
    - '// @input float scrollBtnGapCm = 5 {"hint":"Gap between the up and down scroll buttons, in cm."}'
    - '// @input float cardForwardCm = 1.2 {"hint":"How far cards/text sit in FRONT of the panel background, in cm."}'
    - '// @input float headerForwardCm = 0.8 {"hint":"DEPTH: extra cm the CHOOSE A LESSON header floats in FRONT of the cards. 0 = flat with everything else."}'
    - '// @input float labelForwardCm = 0.5 {"hint":"DEPTH: extra cm the NOVICE / ELEMENTARY / ... labels float in FRONT of the cards. 0 = flat with everything else."}'
    - '// @input float textScale = 1 {"hint":"Fine-tune of all card text size (1 = default)."}'
    - '// @input float titleWrapChars = 18 {"hint":"Wrap titles and tags onto a new line after this many characters (breaks at spaces)."}'
    - '// @input float metaWrapChars = 24 {"hint":"Wrap the meta line (points / obstacles) after this many characters."}'
    - '// @input float labelXCm {"hint":"LEFT EDGE of the level labels, in cm from the panel centre. Labels are left-aligned. 0 = starts at centre; negative = further left."}'
    - '// @input float labelYCm {"hint":"Vertical nudge of the level labels, in cm. Positive = higher above its group; negative = lower."}'
    - '// @input float labelScale = 1 {"hint":"Size of the level labels (1 = default). Lower it, e.g. 0.8, to make them smaller."}'
    - '// @input AssignableType_4 scrollUpButton {"hint":"Optional PinchButton that scrolls the list UP."}'
    - '// @input AssignableType_5 scrollDownButton {"hint":"Optional PinchButton that scrolls the list DOWN."}'
    - '// @input float scrollStepCm = 8 {"hint":"How far each scroll press moves the list, in cm."}'
    - '// @input float viewHeightCm = 26 {"hint":"Visible height of the list area inside the panel, in cm. Taller content can be scrolled."}'
    - "// @input bool autoPlaceScrollButtons {\"hint\":\"Leave OFF to place the Up/Down buttons BY HAND in the scene (drag them where you want and they stay put). Turn ON only if you'd rather auto-position them from the Scroll Btn X/Y/Gap Cm values.\"}"
    - '// @input float clipTopCm {"hint":"TOP CLIP: cards whose centre goes ABOVE this many cm from the panel centre are hidden. Leave 0 to auto-use Top Start Cm as the top edge."}'
    - '// @input float clipBottomCm {"hint":"BOTTOM CLIP: cards whose centre drops BELOW this many cm from the panel centre are hidden. Leave 0 to auto-use (Top Start Cm − View Height Cm)."}'
    - '// @input float clipMarginCm {"hint":"CLIP SLACK, in cm. Added outside both cutoffs so a card that is only slightly over the edge still shows. Negative tightens (hides sooner, so nothing pokes out); e.g. set to −(half a card) for no overflow."}'
    - '// @input AssignableType_6[] closeOnButtons {"hint":"Buttons that should CLOSE this panel when pressed (e.g. Home, Edit, Reload). Drag them here."}'
    - // @input bool showHeader
    - // @input bool showSectionLabels
    - '// @input string headerText = "CHOOSE A LESSON"'
    - '// @input Asset.Texture labelGradient {"hint":"OPTIONAL gradient image for the gold texts (CHOOSE LESSON header + NOVICE/ELEMENTARY/... labels). Leave EMPTY to use the built-in dark-brown -> rust -> yellow -> beige gradient. Drop any vertical gradient PNG here to restyle them."}'
    - // @input bool showThumbnails = true
    - "// @input AssignableType_7 remoteMedia {\"hint\":\"OPTIONAL: only needed to download lessons you didn't bundle.\"}"
    - '// @input Asset.Texture[] noviceThumbs {"hint":"Novice thumbnails IN ORDER: novice1, novice2, ..."}'
    - '// @input Asset.Texture[] elementaryThumbs {"hint":"Elementary thumbnails IN ORDER"}'
    - '// @input Asset.Texture[] intermediateThumbs {"hint":"Intermediate thumbnails IN ORDER"}'
    - '// @input Asset.Texture[] advancedThumbs {"hint":"Advanced thumbnails IN ORDER"}'
    - '// @input string titleChildName = "Title"'
    - '// @input string tagChildName = "Tag"'
    - '// @input string metaChildName = "Meta"'
    - '// @input string thumbChildName = "Thumb"'
    - '// @input string loadButtonChildName = "LoadButton"'
